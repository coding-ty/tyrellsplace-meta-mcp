/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tyrellsplace-meta-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // The URL MCP clients connect to. Set it to your deployed URL, for example
  // https://<worker-name>.<your-subdomain>.workers.dev/mcp
  // ...
  "vars": {
    "MCP_RESOURCE": "https://tyrellsplace-meta-mcp.tmccalmon94.workers.dev/mcp",
    "META_GRAPH_VERSION": "v26.0",
    "META_PAGE_ID": "104591341625071"
  },
  // ...,
  /**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 * 
	 * Commands to set secrets:
	 * npx wrangler secret put GITHUB_CLIENT_ID
	 * npx wrangler secret put GITHUB_CLIENT_SECRET
	 * npx wrangler secret put COOKIE_ENCRYPTION_KEY
	 */
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "c5370dd266ea4414999c7830bf6e00ee"}],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "COOKIE_ENCRYPTION_KEY"
    ]
  }
}
